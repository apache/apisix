                    "error_msg"
                  ],
                  "properties": {
                    "error_msg": {
                      "type": "string",
                      "example": "invalid src type route"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Resource or health checker not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error_msg"
                  ],
                  "properties": {
                    "error_msg": {
                      "type": "string",
                      "example": "routes[1] not found"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Failed to render the HTML health-check response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error_msg"
                  ],
                  "properties": {
                    "error_msg": {
                      "type": "string",
                      "pattern": "^HTML template rendering: .+$",
                      "description": "Lua template rendering error prefixed with `HTML template rendering: `."
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "getResourceHealthChecker"
      }
    },

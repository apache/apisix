{
  "openapi": "3.1.0",
  "info": {
    "title": "Apache APISIX Control API",
    "description": "Use the Apache APISIX Control API to inspect or control the runtime state of one APISIX instance. It is enabled by default at `http://127.0.0.1:9090`; configure `apisix.enable_control` and `apisix.control` in `conf/config.yaml`. The API does not provide authentication, so keep it on a loopback or otherwise trusted internal interface and never expose it to public traffic.\n\nCore endpoints are always registered. Enabled plugins and configured service discovery modules can register the additional endpoints identified in their operation descriptions.",
    "version": "3.16.0",
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "security": [],
  "tags": [
    {
      "name": "Schema",
      "description": "The schema defines the available parameters as well as their data types, properties, default values, valid values, and so on."
    },
    {
      "name": "Health Check",
      "description": "Health checking is a mechanism that determines whether upstream services are healthy or unhealthy based on their responsiveness."
    },
    {
      "name": "Garbage Collection",
      "description": "Garbage collection is a form of automatic memory management. The garbage collector attempts to reclaim memory which was allocated by the program, but is no longer referenced."
    },
    {
      "name": "Route",
      "description": "A route defines a path to one or more upstream services.  \n\nSee [Routes](https://apisix.apache.org/docs/apisix/3.16/terminology/route/) for more information."
    },
    {
      "name": "Upstream",
      "description": "An upstream is a logical abstraction of one or more upstream addresses.  \n\nSee [Upstreams](https://apisix.apache.org/docs/apisix/3.16/terminology/upstream/) for more information."
    },
    {
      "name": "Service",
      "description": "A service is a backend application providing a set of functionalities.  \n\nSee [Services](https://apisix.apache.org/docs/apisix/3.16/terminology/service/) for more information."
    },
    {
      "name": "Plugin Metadata",
      "description": "Plugin metadata is used to configure the common metadata field(s) of all plugin instances sharing the same plugin name.  \nSee [Plugin Metadata](https://apisix.apache.org/docs/apisix/3.16/terminology/plugin-metadata/) for more information."
    },
    {
      "name": "Plugin",
      "description": "Plugins extend base functionalities of APISIX to meet user-specific requirements.  \n  \nSee [Plugins](https://apisix.apache.org/docs/apisix/3.16/terminology/plugin/) for more information."
    },
    {
      "name": "Service Discovery",
      "description": "Service discovery is a process used in microservice-based architectures for automatically detecting and registering dynamically assigned upstream addresses. \n\nSee [Service Discovery](https://apisix.apache.org/docs/apisix/3.16/discovery/#embedded-control-api-for-debugging) for more information."
    },
    {
      "name": "Server Information",
      "description": "The `server-info` plugin adds an endpoint that reports information about the local APISIX instance. This plugin is deprecated in APISIX 3.13.0."
    }
  ],
  "paths": {
    "/v1/schema": {
      "get": {
        "summary": "Get JSON Schema",
        "deprecated": false,
        "description": "Get the JSON schema used by the gateway instance. Only loaded plugins are included.",
        "tags": [
          "Schema"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "successful": {
                    "summary": "Successful response",
                    "value": {
                      "main": {
                        "route": {
                          "properties": {}
                        },
                        "upstream": {
                          "properties": {}
                        }
                      },
                      "plugins": {
                        "example-plugin": {
                          "version": 0.1,
                          "priority": 0,
                          "schema": {
                            "type": "object",
                            "properties": {
                              "_meta": {
                                "type": "object",
                                "properties": {
                                  "disable": {
                                    "type": "boolean"
                                  },
                                  "error_response": {
                                    "oneOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "object"
                                      }
                                    ]
                                  },
                                  "priority": {
                                    "description": "priority of plugins by customized order",
                                    "type": "integer"
                                  },
                                  "filter": {
                                    "description": "filter determines whether the plugin needs to be executed at runtime",
                                    "type": "array"
                                  },
                                  "pre_function": {
                                    "description": "function to be executed in each phase before execution of plugins. The pre_function will have access to two arguments: `conf` and `ctx`.",
                                    "type": "string"
                                  }
                                },
                                "additionalProperties": false
                              },
                              "i": {
                                "type": "number",
                                "minimum": 0
                              },
                              "s": {
                                "type": "string"
                              },
                              "t": {
                                "type": "array",
                                "minItems": 1
                              },
                              "ip": {
                                "type": "string"
                              },
                              "port": {
                                "type": "integer"
                              }
                            },
                            "required": [
                              "i"
                            ],
                            "$comment": "this is a mark for our injected plugin schema"
                          },
                          "metadata_schema": {
                            "type": "object",
                            "properties": {
                              "ikey": {
                                "type": "number",
                                "minimum": 0
                              },
                              "skey": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "ikey",
                              "skey"
                            ]
                          }
                        }
                      },
                      "stream_plugins": {
                        "mqtt-proxy": {
                          "schema": {
                            "type": "object",
                            "properties": {
                              "_meta": {
                                "type": "object",
                                "properties": {
                                  "disable": {
                                    "type": "boolean"
                                  },
                                  "error_response": {
                                    "oneOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "object"
                                      }
                                    ]
                                  },
                                  "priority": {
                                    "description": "priority of plugins by customized order",
                                    "type": "integer"
                                  },
                                  "filter": {
                                    "description": "filter determines whether the plugin needs to be executed at runtime",
                                    "type": "array"
                                  },
                                  "pre_function": {
                                    "description": "function to be executed in each phase before execution of plugins. The pre_function will have access to two arguments: `conf` and `ctx`.",
                                    "type": "string"
                                  }
                                },
                                "additionalProperties": false
                              },
                              "protocol_name": {
                                "type": "string",
                                "default": "MQTT"
                              },
                              "protocol_level": {
                                "type": "integer"
                              }
                            },
                            "required": [
                              "protocol_level"
                            ],
                            "$comment": "this is a mark for our injected plugin schema"
                          },
                          "priority": 1000
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "getSchema"
      }
    },
    "/v1/healthcheck": {
      "get": {
        "summary": "Get Health Check Information",
        "deprecated": false,
        "description": "Get health-check information for this APISIX instance. Configuring checks creates checker entries; send traffic through an upstream to initialize its target nodes. On this release line, an empty collection is encoded as `{}`.",
        "tags": [
          "Health Check"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    {
                      "type": "object",
                      "maxProperties": 0,
                      "description": "Empty collection before any matching runtime state or configuration exists."
                    }
                  ]
                },
                "examples": {
                  "1": {
                    "summary": "etcd Provider Example",
                    "value": [
                      {
                        "nodes": [
                          {
                            "ip": "52.86.68.46",
                            "counter": {
                              "http_failure": 0,
                              "success": 0,
                              "timeout_failure": 0,
                              "tcp_failure": 0
                            },
                            "port": 80,
                            "status": "healthy",
                            "hostname": "52.86.68.46"
                          },
                          {
                            "ip": "100.24.156.8",
                            "counter": {
                              "http_failure": 5,
                              "success": 0,
                              "timeout_failure": 0,
                              "tcp_failure": 0
                            },
                            "port": 80,
                            "status": "unhealthy",
                            "hostname": "100.24.156.8"
                          }
                        ],
                        "name": "/apisix/routes/1",
                        "type": "http"
                      }
                    ]
                  },
                  "empty": {
                    "summary": "Empty Collection",
                    "value": {}
                  }
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                },
                "example": "<html><body><table>...</table></body></html>"
              }
            }
          },
          "503": {
            "description": "Failed to render the HTML health-check response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error_msg"
                  ],
                  "properties": {
                    "error_msg": {
                      "type": "string",
                      "pattern": "^HTML template rendering: .+$",
                      "description": "Lua template rendering error prefixed with `HTML template rendering: `."
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "listHealthCheckers"
      }
    },
    "/v1/healthcheck/{src_type}/{src_id}": {
      "get": {
        "summary": "Get Health Status By Type and ID",
        "deprecated": false,
        "description": "Get health status of a specified resource.",
        "tags": [
          "Health Check"
        ],
        "parameters": [
          {
            "name": "src_type",
            "in": "path",
            "description": "The specified resource type.",
            "required": true,
            "example": "routes",
            "schema": {
              "type": "string",
              "enum": [
                "routes",
                "services",
                "upstreams",
                "stream_routes"
              ]
            }
          },
          {
            "name": "src_id",
            "in": "path",
            "description": "The specified node ID.",
            "required": true,
            "example": "1",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "1": {
                    "summary": "etcd Provider Example",
                    "value": {
                      "nodes": [
                        {
                          "ip": "52.86.68.46",
                          "counter": {
                            "http_failure": 0,
                            "success": 2,
                            "timeout_failure": 0,
                            "tcp_failure": 0
                          },
                          "port": 80,
                          "status": "healthy",
                          "hostname": "52.86.68.46"
                        },
                        {
                          "ip": "100.24.156.8",
                          "counter": {
                            "http_failure": 5,
                            "success": 0,
                            "timeout_failure": 0,
                            "tcp_failure": 0
                          },
                          "port": 80,
                          "status": "unhealthy",
                          "hostname": "100.24.156.8"
                        }
                      ],
                      "type": "http",
                      "name": "/apisix/routes/1"
                    }
                  }
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                },
                "example": "<html><body><table>...</table></body></html>"
              }
            }
          },
          "400": {
            "description": "Invalid src type",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",

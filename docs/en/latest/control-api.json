    "/v1/discovery/{service}/dump": {
      "get": {
        "summary": "Get Memory Dump",
        "operationId": "getServiceDiscoveryDump",
        "deprecated": false,
        "description": "Get the in-memory service and configuration data for a configured service discovery module. This endpoint exists only when the module implements runtime data dumping.",
        "tags": [
          "Service Discovery"
        ],
        "parameters": [
          {
            "name": "service",
            "in": "path",
            "required": true,
            "description": "Configured service discovery module name.",
            "schema": {
              "type": "string"
            },
            "example": "consul"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "1": {
                    "summary": "Successful Example",
                    "value": {
                      "services": {
                        "svc-a": [
                          {
                            "host": "192.168.42.145",
                            "weight": 1,
                            "port": 9081
                          },
                          {
                            "host": "192.168.42.145",
                            "weight": 1,
                            "port": 9082
                          }
                        ]
                      },
                      "config": {
                        "dump": {
                          "load_on_init": true,
                          "expire": 2592000,
                          "path": "logs/consul.dump"
                        },
                        "timeout": {
                          "wait": 60,
                          "read": 2000,
                          "connect": 2000
                        },
                        "fetch_interval": 3,
                        "keepalive": true,
                        "weight": 1,
                        "servers": [
                          "http://consul:8500"
                        ],
                        "token": ""
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/discovery/{service}/show_dump_file": {
      "get": {
        "summary": "Get Dump File",
        "operationId": "getServiceDiscoveryDumpFile",
        "deprecated": false,
        "description": "Read the persisted service discovery dump. This endpoint is currently provided by compatible service discovery modules such as Consul and exists only when the module is configured.",
        "tags": [
          "Service Discovery"
        ],
        "parameters": [
          {
            "name": "service",
            "in": "path",
            "required": true,
            "description": "Configured service discovery module name.",
            "schema": {
              "type": "string"
            },
            "example": "consul"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "description": "Persisted service discovery dump encoded as JSON text."
                },
                "example": "{\"last_update\":1703594980,\"services\":{\"svc-a\":[{\"host\":\"192.168.42.145\",\"weight\":1,\"port\":9081},{\"host\":\"192.168.42.145\",\"weight\":1,\"port\":9082}]},\"expire\":2592000}"
              }
            }
          },
          "503": {
            "description": "The dump file is not configured or could not be read.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "dump params is nil"
              }
            }
          }
        }
      }
    },
    "/v1/server_info": {
      "get": {
        "summary": "Get Server Information",
        "operationId": "getServerInfo",
        "description": "Get information about the local APISIX instance. This endpoint is available only when the `server-info` plugin is enabled. The plugin is deprecated in APISIX 3.13.0.",
        "tags": [
          "Server Information"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "boot_time",
                    "hostname",
                    "id",
                    "version",
                    "etcd_version"
                  ],
                  "properties": {
                    "boot_time": {
                      "type": "integer",
                      "description": "Instance boot time as a Unix timestamp."
                    },
                    "hostname": {
                      "type": "string",
                      "description": "Instance hostname."
                    },
                    "id": {
                      "type": "string",
                      "description": "Instance ID."
                    },
                    "version": {
                      "type": "string",
                      "description": "APISIX version."
                    },
                    "etcd_version": {
                      "type": "string",
                      "description": "etcd version, or `unknown` when unavailable."
                    }
                  }
                },
                "example": {
                  "boot_time": 1608522102,
                  "hostname": "gateway-1",
                  "id": "b7ce1c5c-b1aa-4df7-888a-cbe403f3e948",
                  "version": "3.19.0",
                  "etcd_version": "3.5.0"
                }
              }
            }
          },
          "500": {
            "description": "Server information could not be read."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthChecker": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Resource or plugin target path identifying this checker."
          },
          "type": {
            "type": "string",
            "description": "Configured active check type, or passive check type when no active type is set."
          },
          "plugin": {
            "type": "string",
            "description": "Owning plugin name, present for plugin-owned checkers."
          },
          "meta": {
            "type": "object",
            "additionalProperties": true,
            "description": "Optional plugin-defined target metadata; its keys depend on the plugin."
          },
          "nodes": {
            "type": "array",
            "description": "Registered targets. An empty target list is `[]`, not an object.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:9090",
      "description": "Local APISIX instance"
    }
  ]
}

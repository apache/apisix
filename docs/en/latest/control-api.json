    "/v1/discovery/{service}/dump": {
      "get": {
        "summary": "Get Memory Dump",
        "deprecated": false,
        "description": "Get module-defined in-memory data for a configured service discovery module. Response shape varies by module; the example shows Consul's `config` and `services` object. This endpoint exists only when the module implements runtime data dumping.",
        "tags": [
          "Service Discovery"
        ],
        "parameters": [
          {
            "name": "service",
            "in": "path",
            "required": true,
            "description": "Configured service discovery module name.",
            "schema": {
              "type": "string"
            },
            "example": "consul"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "1": {
                    "summary": "Consul Example",
                    "value": {
                      "services": {
                        "svc-a": [
                          {
                            "host": "192.168.42.145",
                            "weight": 1,
                            "port": 9081
                          },
                          {
                            "host": "192.168.42.145",
                            "weight": 1,
                            "port": 9082
                          }
                        ]
                      },
                      "config": {
                        "dump": {
                          "load_on_init": true,
                          "expire": 2592000,
                          "path": "logs/consul.dump"
                        },
                        "timeout": {
                          "wait": 60,
                          "read": 2000,
                          "connect": 2000
                        },
                        "fetch_interval": 3,
                        "keepalive": true,
                        "weight": 1,
                        "servers": [
                          "http://consul:8500"
                        ],
                        "token": ""
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "getDiscoveryMemoryDump"
      }
    },
    "/v1/discovery/{service}/show_dump_file": {
      "get": {
        "summary": "Get Dump File",
        "deprecated": false,
        "description": "Read the persisted service discovery dump. This endpoint is currently provided by compatible service discovery modules such as Consul and exists only when the module is configured.",
        "tags": [
          "Service Discovery"
        ],
        "parameters": [
          {
            "name": "service",
            "in": "path",
            "required": true,
            "description": "Configured service discovery module name.",
            "schema": {
              "type": "string"
            },
            "example": "consul"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "description": "Persisted service discovery dump encoded as JSON text."
                },
                "example": "{\"last_update\":1703594980,\"services\":{\"svc-a\":[{\"host\":\"192.168.42.145\",\"weight\":1,\"port\":9081},{\"host\":\"192.168.42.145\",\"weight\":1,\"port\":9082}]},\"expire\":2592000}"
              }
            }
          },
          "503": {
            "description": "The dump file is not configured or could not be read.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "dump params is nil"
              }
            }
          }
        },
        "operationId": "getDiscoveryDumpFile"
      }
    },
    "/v1/server_info": {
      "get": {
        "summary": "Get Server Information",
        "description": "Get information about the local APISIX instance. This endpoint is available only when the `server-info` plugin is enabled. The plugin is deprecated in APISIX 3.13.0.",
        "tags": [
          "Server Information"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "boot_time",
                    "hostname",
                    "id",
                    "version",
                    "etcd_version"
                  ],
                  "properties": {
                    "boot_time": {
                      "type": "integer",
                      "description": "Instance boot time as a Unix timestamp."
                    },
                    "hostname": {
                      "type": "string",
                      "description": "Instance hostname."
                    },
                    "id": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        }
                      ],
                      "description": "Configured APISIX instance ID."
                    },
                    "version": {
                      "type": "string",
                      "description": "APISIX version."
                    },
                    "etcd_version": {
                      "type": "string",
                      "description": "etcd version, or `unknown` when unavailable."
                    }
                  }
                },
                "example": {
                  "boot_time": 1608522102,
                  "hostname": "gateway-1",
                  "id": "b7ce1c5c-b1aa-4df7-888a-cbe403f3e948",
                  "version": "3.16.0",
                  "etcd_version": "3.5.0"
                }
              }
            }
          },
          "500": {
            "description": "Server information could not be read."
          }
        },
        "operationId": "getServerInformation"
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:9090",
      "description": "Local APISIX instance"
    }
  ]

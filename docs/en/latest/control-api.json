{
  "openapi": "3.1.0",
  "info": {
    "title": "APISIX Control API",
    "description": "Use the APISIX Control API to inspect or control the runtime state of one APISIX instance. It is enabled by default at `http://127.0.0.1:9090`; configure `apisix.enable_control` and `apisix.control` in [`conf/config.yaml`](https://github.com/apache/apisix/blob/master/conf/config.yaml.example). The API does not provide authentication, so keep it on a loopback or otherwise trusted internal interface and never expose it to public traffic.\n\nMost endpoints in this reference are provided by the APISIX core. The Server Information and Service Discovery groups describe stable endpoint patterns registered only when the corresponding plugin or module is enabled. Enabled plugins and service discovery modules can register additional endpoints.",
    "version": "3.19.0",
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "security": [],
  "tags": [
    {
      "name": "Schema",
      "description": "The schema defines the available parameters as well as their data types, properties, default values, valid values, and so on."
    },
    {
      "name": "Health Check",
      "description": "Health checking is a mechanism that determines whether upstream services are healthy or unhealthy based on their responsiveness."
    },
    {
      "name": "Garbage Collection",
      "description": "Garbage collection is a form of automatic memory management. The garbage collector attempts to reclaim memory which was allocated by the program, but is no longer referenced."
    },
    {
      "name": "Route",
      "description": "A route defines a path to one or more upstream services.  \n\nSee [Routes](https://apisix.apache.org/docs/apisix/next/terminology/route/) for more information."
    },
    {
      "name": "Upstream",
      "description": "An upstream is a logical abstraction of one or more upstream addresses.  \n\nSee [Upstreams](https://apisix.apache.org/docs/apisix/next/terminology/upstream/) for more information."
    },
    {
      "name": "Service",
      "description": "A service is a backend application providing a set of functionalities.  \n\nSee [Services](https://apisix.apache.org/docs/apisix/next/terminology/service/) for more information."
    },
    {
      "name": "Plugin Metadata",
      "description": "Plugin metadata is used to configure the common metadata field(s) of all plugin instances sharing the same plugin name.  \nSee [Plugin Metadata](https://apisix.apache.org/docs/apisix/next/terminology/plugin-metadata/) for more information."
    },
    {
      "name": "Plugin",
      "description": "Plugins extend base functionalities of APISIX to meet user-specific requirements.  \n  \nSee [Plugins](https://apisix.apache.org/docs/apisix/next/terminology/plugin/) for more information."
    },
    {
      "name": "Service Discovery",
      "description": "Service discovery is a process used in microservice-based architectures for automatically detecting and registering dynamically assigned upstream addresses. \n\nSee [Service Discovery](https://apisix.apache.org/docs/apisix/next/discovery/#embedded-control-api-for-debugging) for more information."
    },
    {
      "name": "Server Information",
      "description": "The `server-info` plugin adds an endpoint that reports information about the local APISIX instance. This plugin is deprecated in APISIX 3.13.0."
    }
  ],

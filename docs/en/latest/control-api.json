    "/v1/schema": {
      "get": {
        "summary": "Get JSON Schema",
        "operationId": "getSchema",
        "deprecated": false,
        "description": "Get the JSON schema used by the gateway instance. Only loaded plugins are included.",
        "tags": [
          "Schema"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "successful": {
                    "summary": "Successful response",
                    "value": {
                      "main": {
                        "route": {
                          "properties": {}
                        },
                        "upstream": {
                          "properties": {}
                        }
                      },
                      "plugins": {
                        "example-plugin": {
                          "consumer_schema": {},
                          "metadata_schema": {},
                          "schema": {},
                          "type": "object",
                          "priority": 0,
                          "version": 0.1
                        }
                      },
                      "stream-plugins": {
                        "mqtt-proxy": {}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/healthcheck": {
      "get": {
        "summary": "Get Health Check Information",
        "operationId": "getHealthChecks",
        "deprecated": false,
        "description": "Get health check information for this APISIX instance. Send traffic to initialize upstream checker targets. The listing also includes checkers exposed by enabled plugins, such as `ai-proxy-multi`. An empty listing, and a checker with no targets, use JSON arrays (`[]`). Each plugin entry identifies the owning plugin in `plugin` and can include plugin-defined `meta` information. This is local runtime state, not fleet-wide readiness.",
        "tags": [
          "Health Check"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "examples": {
                  "1": {
                    "summary": "Successful Example",
                    "value": [
                      {
                        "nodes": [
                          {
                            "ip": "52.86.68.46",
                            "counter": {
                              "http_failure": 0,
                              "success": 0,
                              "timeout_failure": 0,
                              "tcp_failure": 0
                            },
                            "port": 80,
                            "status": "healthy"
                          },
                          {
                            "ip": "100.24.156.8",
                            "counter": {
                              "http_failure": 5,
                              "success": 0,
                              "timeout_failure": 0,
                              "tcp_failure": 0
                            },
                            "port": 80,
                            "status": "unhealthy"
                          }
                        ],
                        "name": "/apisix/routes/1",
                        "type": "http"
                      }
                    ]
                  }
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                },
                "example": "<html><body><table>...</table></body></html>"
              }
            }
          },
          "503": {
            "description": "Failed to render the HTML health-check response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error_msg"
                  ],
                  "properties": {
                    "error_msg": {
                      "type": "string",
                      "example": "HTML template rendering failed."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/healthcheck/{src_type}/{src_id}/checkers": {
      "get": {
        "summary": "List All Checkers Owned by a Resource",
        "operationId": "getResourceHealthCheckers",
        "description": "List the upstream checker and checkers exposed by enabled plugins on this resource. Returns an empty array for an existing resource without checkers. Does not follow a route's service or upstream references; query the owning resource. The Control API has no authentication and must remain on a trusted interface.",
        "tags": [
          "Health Check"
        ],
        "parameters": [
          {
            "name": "src_type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "routes",
                "services",
                "upstreams",
                "stream_routes"
              ]
            }
          },
          {
            "name": "src_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Checkers owned by the resource, including an empty array (`[]`) when none are configured.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HealthChecker"
                  }
                },
                "examples": {
                  "empty": {
                    "value": []
                  },
                  "plugin": {
                    "value": [
                      {
                        "name": "/apisix/routes/ai#plugins['ai-proxy-multi'].instances[0]",
                        "plugin": "ai-proxy-multi",
                        "meta": {
                          "instance": "primary"
                        },
                        "type": "http",
                        "nodes": []
                      }
                    ]
                  }
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid resource type or subresource.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error_msg"
                  ],
                  "properties": {
                    "error_msg": {
                      "type": "string",
                      "example": "invalid src type route"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Resource not found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error_msg"
                  ],
                  "properties": {
                    "error_msg": {
                      "type": "string",
                      "example": "routes[1] not found"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Failed to render the HTML response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error_msg"
                  ],
                  "properties": {
                    "error_msg": {
                      "type": "string",
                      "example": "HTML template rendering failed."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

{
  "properties": {
    "client_key": {
      "minLength": 64,
      "maxLength": 65536,
      "type": "string"
    },
    "client_cert": {
      "minLength": 128,
      "maxLength": 65536,
      "type": "string"
    },
    "client_cert_id": {
      "$ref": "./ResourceId.json"
    },
    "verify": {
      "description": "Turn on server certificate verification, currently only kafka upstream is supported",
      "default": false,
      "type": "boolean"
    }
  },
  "type": "object",
  "dependentSchemas": {
    "client_key": {
      "required": [
        "client_cert"
      ]
    },
    "client_cert": {
      "required": [
        "client_key"
      ]
    },
    "client_cert_id": {
      "not": {
        "required": [
          "client_cert",
          "client_key"
        ]
      }
    }
  },
  "x-source": "apisix/schema_def.lua"
}

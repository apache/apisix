{
  "type": "object",
  "description": "Consumer Group configuration. Defines shared plugin configurations for multiple consumers.",
  "required": [
    "plugins"
  ],
  "properties": {
    "id": {
      "$ref": "./ResourceId.json"
    },
    "name": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
      "description": "Human-readable name."
    },
    "desc": {
      "type": "string",
      "maxLength": 256,
      "description": "Description of this group."
    },
    "labels": {
      "$ref": "./Labels.json"
    },
    "create_time": {
      "type": "integer",
      "readOnly": true,
      "description": "Unix timestamp of creation. Read-only."
    },
    "update_time": {
      "type": "integer",
      "readOnly": true,
      "description": "Unix timestamp of last update. Read-only."
    },
    "plugins": {
      "$ref": "./Plugins.json"
    }
  },
  "additionalProperties": false
}

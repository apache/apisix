{
  "type": "object",
  "description": "HashiCorp Vault secret-manager configuration.",
  "properties": {
    "uri": {
      "pattern": "^[^\\/]+:\\/\\/([\\da-zA-Z.-]+|\\[[\\da-fA-F:]+\\])(:\\d+)?",
      "type": "string"
    },
    "prefix": {
      "type": "string",
      "description": "Path prefix for secrets in Vault."
    },
    "token": {
      "type": "string",
      "description": "Vault authentication token or environment-variable URI."
    },
    "namespace": {
      "type": "string",
      "description": "Vault Enterprise or HCP Vault namespace."
    }
  },
  "required": [
    "uri",
    "prefix",
    "token"
  ],
  "x-source": "apisix/secret/vault.lua"
}

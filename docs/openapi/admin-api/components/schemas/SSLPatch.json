{
  "type": "object",
  "properties": {
    "snis": {
      "anyOf": [
        {
          "items": {
            "pattern": "^\\*$|^\\*?[0-9a-zA-Z-._\\[\\]:]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "ssl_protocols": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "TLSv1.1",
              "TLSv1.2",
              "TLSv1.3"
            ]
          },
          "maxItems": 3,
          "description": "set ssl protocols",
          "uniqueItems": true,
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "anyOf": [
        {
          "minLength": 64,
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "labels": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "description": "ssl status, 1 to enable, 0 to disable",
          "enum": [
            1,
            0
          ],
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "cert": {
      "anyOf": [
        {
          "minLength": 128,
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "client": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ca": {
              "anyOf": [
                {
                  "minLength": 128,
                  "maxLength": 65536,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "skip_mtls_uri_regex": {
              "anyOf": [
                {
                  "uniqueItems": true,
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "description": "uri regular expression to skip mtls"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ]
            },
            "depth": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sni": {
      "anyOf": [
        {
          "pattern": "^\\*$|^\\*?[0-9a-zA-Z-._\\[\\]:]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "certs": {
      "anyOf": [
        {
          "items": {
            "minLength": 128,
            "maxLength": 65536,
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "keys": {
      "anyOf": [
        {
          "items": {
            "minLength": 64,
            "maxLength": 65536,
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "desc": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "anyOf": [
        {
          "enum": [
            "server",
            "client"
          ],
          "description": "ssl certificate type, server to server certificate, client to client certificate for upstream",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "$ref": "./ResourceId.json"
    },
    "create_time": {
      "type": "integer",
      "readOnly": true
    },
    "update_time": {
      "type": "integer",
      "readOnly": true
    }
  },
  "additionalProperties": false,
  "description": "Recursive merge fragment. Null deletes object fields; arrays are replaced. APISIX validates the resulting resource, including plugin and reference checks."
}

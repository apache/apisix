{
  "description": "Fields to merge into the existing `PluginConfig`. Object fields are merged recursively; arrays are replaced.",
  "required": true,
  "content": {
    "application/json": {
      "schema": {
        "$ref": "../schemas/PluginConfigPatch.json"
      },
      "examples": {
        "updateDescription": {
          "summary": "Update the plugin config description",
          "value": {
            "desc": "Updated plugin config description"
          }
        },
        "configurePlugin": {
          "summary": "Configure a plugin",
          "value": {
            "plugins": {
              "limit-count": {
                "count": 100,
                "time_window": 60,
                "rejected_code": 429
              }
            }
          }
        }
      }
    }
  }
}

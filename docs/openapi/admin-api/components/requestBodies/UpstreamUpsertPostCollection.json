{
  "description": "`Upstream` configuration body for create / replace / patch.",
  "required": true,
  "content": {
    "application/json": {
      "schema": {
        "allOf": [
          {
            "$ref": "../schemas/Upstream.json"
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "create_time"
                  ]
                },
                {
                  "required": [
                    "update_time"
                  ]
                },
                {
                  "required": [
                    "id"
                  ]
                }
              ]
            }
          }
        ],
        "description": "Wire request body. APISIX injects timestamps and, where appropriate, the path or generated resource ID. A supplied ID must agree with the path."
      },
      "example": {
        "name": "upstream-for-test",
        "desc": "desc",
        "scheme": "http",
        "retries": 1,
        "type": "roundrobin",
        "nodes": {
          "127.0.0.1:1980": 1
        },
        "timeout": {
          "connect": 15,
          "send": 15,
          "read": 15
        }
      }
    }
  }
}

{
  "description": "Fields to merge into the existing secret-manager configuration.",
  "required": true,
  "content": {
    "application/json": {
      "schema": {
        "$ref": "../schemas/SecretPatch.json"
      },
      "examples": {
        "vaultToken": {
          "summary": "Update a Vault token",
          "value": {
            "token": "$ENV://VAULT_TOKEN"
          }
        },
        "awsRegion": {
          "summary": "Update an AWS region",
          "value": {
            "region": "eu-west-1"
          }
        },
        "gcpTls": {
          "summary": "Disable GCP endpoint verification",
          "value": {
            "ssl_verify": false
          }
        }
      }
    }
  }
}

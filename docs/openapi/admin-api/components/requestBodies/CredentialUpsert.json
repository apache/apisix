{
  "description": "`Credential` configuration body for create / replace / patch.",
  "required": true,
  "content": {
    "application/json": {
      "schema": {
        "allOf": [
          {
            "$ref": "../schemas/Credential.json"
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "create_time"
                  ]
                },
                {
                  "required": [
                    "update_time"
                  ]
                }
              ]
            }
          }
        ],
        "description": "Wire request body. APISIX injects timestamps and, where appropriate, the path or generated resource ID. A supplied ID must agree with the path."
      },
      "example": {
        "plugins": {
          "key-auth": {
            "key": "credential-secret-key-456"
          }
        }
      }
    }
  }
}

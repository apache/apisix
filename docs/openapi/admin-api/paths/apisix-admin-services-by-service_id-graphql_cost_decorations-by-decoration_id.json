{
  "parameters": [
    {
      "name": "service_id",
      "in": "path",
      "required": true,
      "description": "ID of the owning service.",
      "schema": {
        "$ref": "../components/schemas/ResourceId.json"
      }
    },
    {
      "name": "decoration_id",
      "in": "path",
      "required": true,
      "description": "Decoration ID, unique within the service.",
      "schema": {
        "$ref": "../components/schemas/ResourceId.json"
      }
    }
  ],
  "get": {
    "tags": [
      "Services"
    ],
    "summary": "Get a GraphQL Cost Decoration",
    "operationId": "getGraphQLCostDecoration",
    "responses": {
      "200": {
        "description": "Decoration found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/GraphQLCostDecorationEnvelope.json"
            }
          }
        }
      },
      "401": {
        "$ref": "../components/responses/Unauthorized.json"
      },
      "404": {
        "description": "The decoration does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ErrorResponse.json"
            }
          }
        }
      },
      "503": {
        "description": "The configuration store is unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ErrorResponse.json"
            }
          }
        }
      }
    },
    "parameters": []
  },
  "put": {
    "tags": [
      "Services"
    ],
    "summary": "Create or Replace a GraphQL Cost Decoration",
    "description": "Replace the complete decoration or create it if absent. The service must exist. Ownership is taken from the URL; a conflicting `service_id` in the body is rejected. Keep `field_path` unique within a service, and serialize concurrent writes for the service.",
    "operationId": "replaceGraphQLCostDecoration",
    "parameters": [],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../components/schemas/GraphQLCostDecoration.json"
          },
          "example": {
            "field_path": "Query.products",
            "add_value": 1,
            "mul_value": 1,
            "mul_arguments": [
              "first"
            ]
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Decoration replaced.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/GraphQLCostDecorationEnvelope.json"
            }
          }
        }
      },
      "201": {
        "description": "Decoration created.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/GraphQLCostDecorationEnvelope.json"
            }
          }
        }
      },
      "400": {
        "description": "Invalid configuration, conflicting service ID, or duplicate `field_path`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ErrorResponse.json"
            }
          }
        }
      },
      "401": {
        "$ref": "../components/responses/Unauthorized.json"
      },
      "404": {
        "description": "The owning service does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ErrorResponse.json"
            }
          }
        }
      },
      "503": {
        "description": "The configuration store is unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ErrorResponse.json"
            }
          }
        }
      }
    }
  },
  "patch": {
    "tags": [
      "Services"
    ],
    "summary": "Update a GraphQL Cost Decoration",
    "description": "Merge fields into an existing decoration. `service_id` cannot be patched, even to its existing value. A changed `field_path` must not duplicate another decoration on the service. JSON subpath patching is not supported for this subresource.",
    "operationId": "updateGraphQLCostDecoration",
    "requestBody": {
      "$ref": "../components/requestBodies/GraphQLCostDecorationPatchBody.json"
    },
    "responses": {
      "200": {
        "description": "Decoration updated.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/GraphQLCostDecorationEnvelope.json"
            }
          }
        }
      },
      "400": {
        "description": "Invalid configuration, conflicting service ID, or duplicate `field_path`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ErrorResponse.json"
            }
          }
        }
      },
      "401": {
        "$ref": "../components/responses/Unauthorized.json"
      },
      "404": {
        "description": "The decoration does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ErrorResponse.json"
            }
          }
        }
      },
      "503": {
        "description": "The configuration store is unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ErrorResponse.json"
            }
          }
        }
      }
    },
    "parameters": []
  },
  "delete": {
    "tags": [
      "Services"
    ],
    "summary": "Delete a GraphQL Cost Decoration",
    "operationId": "deleteGraphQLCostDecoration",
    "responses": {
      "200": {
        "description": "Decoration deleted."
      },
      "401": {
        "$ref": "../components/responses/Unauthorized.json"
      },
      "404": {
        "description": "The decoration does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ErrorResponse.json"
            }
          }
        }
      },
      "503": {
        "description": "The configuration store is unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ErrorResponse.json"
            }
          }
        }
      }
    },
    "parameters": [
      {
        "$ref": "../components/parameters/Force.json"
      }
    ]
  }
}

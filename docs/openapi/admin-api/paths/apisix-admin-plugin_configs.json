  "put": {
    "summary": "Create or replace plugin_configs using a body ID",
    "description": "Equivalent to PUT on the item URL, with id required in the request body. The resource handler injects and validates this ID before persistence.",
    "tags": [
      "Plugin Configs"
    ],
    "parameters": [
      {
        "$ref": "../components/parameters/Ttl.json"
      }
    ],
    "requestBody": {
      "description": "`PluginConfig` configuration body for create / replace / patch.",
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "allOf": [
              {
                "allOf": [
                  {
                    "$ref": "../components/schemas/PluginConfig.json"
                  },
                  {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "create_time"
                          ]
                        },
                        {
                          "required": [
                            "update_time"
                          ]
                        }
                      ]
                    }
                  }
                ],
                "description": "Wire request body. APISIX injects timestamps and, where appropriate, the path or generated resource ID. A supplied ID must agree with the path."
              },
              {
                "required": [
                  "id"
                ]
              }
            ]
          },
          "example": {
            "plugins": {
              "limit-count": {
                "count": 100,
                "time_window": 60,
                "rejected_code": 429,
                "key_type": "var",
                "key": "remote_addr"
              },
              "proxy-rewrite": {
                "uri": "/backend$uri"
              }
            },
            "id": "1"
          }
        }
      }
    },
    "responses": {
      "201": {
        "description": "Created",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/PluginConfigEnvelope.json"
            },
            "examples": {
              "1": {
                "summary": "Successful Example",
                "value": {
                  "key": "/apisix/plugin_configs/1",
                  "value": {
                    "plugins": {
                      "limit-count": {
                        "time_window": 60,
                        "rejected_code": 503,
                        "key": "remote_addr",
                        "key_type": "var",
                        "count": 2,
                        "show_limit_quota_header": true,
                        "allow_degradation": false,
                        "policy": "local"
                      }
                    },
                    "desc": "desc",
                    "id": "1",
                    "create_time": 1684380007,
                    "update_time": 1684380034
                  }
                }
              }
            }
          }
        }
      },
      "400": {
        "$ref": "../components/responses/BadRequest.json",
        "description": "Invalid configuration"
      },
      "401": {
        "$ref": "../components/responses/Unauthorized.json"
      },
      "503": {
        "$ref": "../components/responses/BadRequest.json",
        "description": "Storage access or write failed."
      }
    },
    "operationId": "putPluginConfigWithBodyId"
  }
}

{
  "get": {
    "summary": "List All Routes",
    "description": "Retrieve all configured routes. Supports filtering by `name`, `label`, `uri`, or `filter` expression.\n\nResults include full route configuration and metadata (creation/update timestamps).",
    "tags": [
      "Routes"
    ],
    "parameters": [
      {
        "$ref": "../components/parameters/NameFilter.json"
      },
      {
        "$ref": "../components/parameters/LabelFilter.json"
      },
      {
        "$ref": "../components/parameters/UriFilter.json"
      },
      {
        "$ref": "../components/parameters/FilterExpr.json"
      },
      {
        "$ref": "../components/parameters/Page.json"
      },
      {
        "$ref": "../components/parameters/PageSize.json"
      }
    ],
    "responses": {
      "200": {
        "description": "Successful response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/RouteListEnvelope.json"
            },
            "examples": {
              "1": {
                "summary": "Successful Example",
                "value": {
                  "total": 1,
                  "list": [
                    {
                      "createdIndex": 203,
                      "key": "/apisix/routes/1",
                      "value": {
                        "remote_addrs": [
                          "127.0.0.1"
                        ],
                        "desc": "desc",
                        "name": "route-test",
                        "priority": 0,
                        "vars": [
                          [
                            "http_user",
                            "==",
                            "ios"
                          ]
                        ],
                        "update_time": 1684490006,
                        "create_time": 1684490006,
                        "id": "1",
                        "plugins": {
                          "limit-count": {
                            "show_limit_quota_header": true,
                            "policy": "local",
                            "count": 2,
                            "allow_degradation": false,
                            "rejected_code": 503,
                            "time_window": 60,
                            "key_type": "var",
                            "key": "remote_addr"
                          }
                        },
                        "status": 1,
                        "timeout": {
                          "read": 3,
                          "connect": 3,
                          "send": 3
                        },
                        "uri": "/ip",
                        "upstream": {
                          "hash_on": "vars",
                          "pass_host": "pass",
                          "nodes": {
                            "httpbin.org:80": 1
                          },
                          "type": "roundrobin",
                          "scheme": "http"
                        },
                        "methods": [
                          "GET",
                          "POST"
                        ],
                        "hosts": [
                          "a.com",
                          "b.com"
                        ]
                      },
                      "modifiedIndex": 203
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "401": {
        "$ref": "../components/responses/Unauthorized.json"
      }
    },
    "operationId": "listRoutes",
    "x-codeSamples": [
      {
        "lang": "cURL",
        "label": "cURL",
        "source": "curl -i http://127.0.0.1:9180/apisix/admin/routes \\\n  -H 'X-API-KEY: your-api-key'"
      }
    ]
  },
  "post": {
    "summary": "Create a Route",
    "description": "Create a new route with an auto-generated ID.\n\nA route must include `uri` or `uris`, and one of: `upstream` (inline), `upstream_id`, `service_id`, `plugins`, or `script`.",
    "tags": [
      "Routes"
    ],
    "parameters": [
      {
        "$ref": "../components/parameters/Ttl.json"
      }
    ],
    "requestBody": {
      "$ref": "../components/requestBodies/RouteUpsertPostCollection.json"
    },
    "responses": {
      "201": {
        "description": "Created",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/RouteEnvelope.json"
            },
            "examples": {
              "1": {
                "summary": "Successful Example",
                "value": {
                  "value": {
                    "desc": "desc",
                    "name": "route-name",
                    "update_time": 1684490245,
                    "priority": 0,
                    "id": "00000000000000000206",
                    "status": 1,
                    "create_time": 1684490245,
                    "uri": "/ip",
                    "upstream": {
                      "hash_on": "vars",
                      "pass_host": "pass",
                      "nodes": {
                        "httpbin.org:80": 1
                      },
                      "type": "roundrobin",
                      "scheme": "http"
                    },
                    "methods": [
                      "GET",
                      "POST"
                    ],
                    "hosts": [
                      "a.com",
                      "b.com"
                    ]
                  },
                  "key": "/apisix/routes/00000000000000000206"
                }
              }
            }
          }
        }
      },
      "400": {
        "$ref": "../components/responses/BadRequest.json",
        "description": "Invalid configuration"
      },
      "401": {
        "$ref": "../components/responses/Unauthorized.json"
      }
    },
    "operationId": "createRoute",
    "x-codeSamples": [
      {
        "lang": "cURL",
        "label": "cURL",
        "source": "curl -i http://127.0.0.1:9180/apisix/admin/routes \\\n  -H 'X-API-KEY: your-api-key' \\\n  -H 'Content-Type: application/json' \\\n  -X POST -d '{\n    \"uri\": \"/api/v1/users/*\",\n    \"upstream\": {\n      \"type\": \"roundrobin\",\n      \"nodes\": {\"10.0.0.1:8080\": 1}\n    }\n  }'"
      }
    ]
  }
}

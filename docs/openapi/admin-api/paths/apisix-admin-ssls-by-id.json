  "delete": {
    "summary": "Delete an SSL Certificate",
    "description": "Delete an SSL certificate by its ID.",
    "tags": [
      "SSL Certificates"
    ],
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "description": "Unique identifier of the resource. Can be a string (alphanumeric, `-`, `_`, `.`) or a positive integer.",
        "required": true,
        "example": "my-resource-1",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "force",
        "in": "query",
        "description": "Delete resource by force even if the resource is in use.",
        "required": false,
        "example": "true",
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Successful response.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "key": {
                  "description": "The storage key or path identifier for the SSL object in the data store.",
                  "type": "string"
                },
                "deleted": {
                  "description": "The ID of the successfully deleted SSL.",
                  "type": "string"
                }
              }
            },
            "examples": {
              "1": {
                "summary": "Successful Example",
                "value": {
                  "key": "/apisix/ssls/00000000000000000134",
                  "deleted": "1"
                }
              }
            }
          }
        }
      },

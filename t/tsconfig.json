{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "allowJs": true
  },
  "include": ["**/*.ts", "**/*.cts", "**/*.js"]
}
